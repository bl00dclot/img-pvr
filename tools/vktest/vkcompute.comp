#version 450
// SPDX-License-Identifier: MIT
// The same job as glwork compute: one 64-invocation workgroup writing v[i] = 3i + 1.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer B { uint v[]; };
void main() { v[gl_GlobalInvocationID.x] = gl_GlobalInvocationID.x * 3u + 1u; }
